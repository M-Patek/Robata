FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN python -m pip install --no-cache-dir "uv==0.11.29" \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin robata

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts ./scripts
COPY schemas ./schemas
COPY config ./config
COPY db ./db

RUN uv sync --locked --no-dev --extra mcap --extra r2 --extra pgvector --extra redis --extra web \
    && install -d -o robata -g robata -m 0750 /var/lib/robata

USER robata

ENV PATH="/app/.venv/bin:${PATH}"

ENTRYPOINT ["python"]
CMD ["scripts/verify_canonical_postgres_deployment.py", "--help"]
