# Optional adapter configuration used by scripts/preflight_optional_adapters.py.
# Replace placeholders with local secrets outside version control. Omit optional
# variables instead of assigning them empty values.

# Cloudflare R2 (the adapter uses an explicit S3-compatible HTTPS endpoint).
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>
R2_PREFIX=robata
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# pgvector primary role and independent worker role. RLS is always required.
PGVECTOR_HOST=<postgres-host>
PGVECTOR_DATABASE=postgres
PGVECTOR_USER=<application-role>
PGVECTOR_PASSWORD=<application-password>
PGVECTOR_SSLMODE=verify-full
PGVECTOR_SSLROOTCERT=/absolute/path/to/ca-certificate.pem
PGVECTOR_DIMENSION=<embedding-dimension>
PGVECTOR_BACKEND=POSTGRES
PGVECTOR_REQUIRE_RLS=true

PGVECTOR_WORKER_HOST=<postgres-host>
PGVECTOR_WORKER_DATABASE=postgres
PGVECTOR_WORKER_USER=<worker-role-login>
PGVECTOR_WORKER_PASSWORD=<worker-password>
PGVECTOR_WORKER_SSLMODE=verify-full
PGVECTOR_WORKER_SSLROOTCERT=/absolute/path/to/ca-certificate.pem
PGVECTOR_WORKER_ROLE=<worker-role>

# Optional relation/index/policy settings must be omitted unless deliberately pinned.
# PGVECTOR_RELATION=public.robata_vector_projection
# PGVECTOR_VECTOR_COLUMN=embedding
# PGVECTOR_INDEX_NAME=robata_vector_projection_hnsw
# PGVECTOR_RLS_POLICY_NAME=robata_vector_projection_tenant_access
