{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.robata.dev/v2/camera-video-export-manifest.schema.json",
  "title": "Robata CameraVideoExportManifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "semantic_content_sha256",
    "execution_mode",
    "recording_identity",
    "source_content_sha256",
    "source_size_bytes",
    "source_artifact_id",
    "mapping_profile_artifact_id",
    "export_config_artifact_id",
    "mapping_profile",
    "ready_manifest_id",
    "ready_manifest_semantic_sha256",
    "alignment_id",
    "alignment_semantic_sha256",
    "alignment_status",
    "exporter",
    "cameras"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "schema_ref": {
      "allOf": [
        {
          "$ref": "artifact-registry-entry.schema.json#/$defs/schemaArtifactReference"
        },
        {
          "properties": {
            "schema_id": {
              "const": "https://schemas.robata.dev/camera-video-export-manifest"
            },
            "version": {"const": "2.0.0"}
          }
        }
      ]
    },
    "semantic_content_sha256": {
      "$ref": "../v1/common.schema.json#/$defs/sha256"
    },
    "execution_mode": {
      "enum": ["GOVERNED_READY", "LOCAL_DEVELOPMENT_OVERRIDE"]
    },
    "recording_identity": {
      "$ref": "../v1/common.schema.json#/$defs/sha256"
    },
    "source_content_sha256": {
      "$ref": "../v1/common.schema.json#/$defs/sha256"
    },
    "source_size_bytes": {"type": "integer", "minimum": 1},
    "source_artifact_id": {
      "$ref": "artifact-registry-entry.schema.json#/$defs/artifactId"
    },
    "mapping_profile_artifact_id": {
      "$ref": "artifact-registry-entry.schema.json#/$defs/artifactId"
    },
    "export_config_artifact_id": {
      "$ref": "artifact-registry-entry.schema.json#/$defs/artifactId"
    },
    "mapping_profile": {
      "$ref": "../v1/camera-video-export-manifest.schema.json#/$defs/mappingProfile"
    },
    "ready_manifest_id": {
      "oneOf": [
        {"$ref": "../v1/common.schema.json#/$defs/uuid"},
        {"type": "null"}
      ]
    },
    "ready_manifest_semantic_sha256": {
      "oneOf": [
        {"$ref": "../v1/common.schema.json#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "alignment_id": {
      "oneOf": [
        {"$ref": "../v1/common.schema.json#/$defs/uuid"},
        {"type": "null"}
      ]
    },
    "alignment_semantic_sha256": {
      "oneOf": [
        {"$ref": "../v1/common.schema.json#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "alignment_status": {"enum": ["UNVERIFIED", "VALID"]},
    "exporter": {
      "$ref": "../v1/camera-video-export-manifest.schema.json#/$defs/exporter"
    },
    "cameras": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_01"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_02"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_03"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_04"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_05"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_06"}}}
          ]
        }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {"const": "LOCAL_DEVELOPMENT_OVERRIDE"}
        },
        "required": ["execution_mode"]
      },
      "then": {
        "properties": {
          "ready_manifest_id": {"type": "null"},
          "ready_manifest_semantic_sha256": {"type": "null"},
          "mapping_profile": {
            "properties": {"approved": {"const": false}},
            "required": ["approved"]
          },
          "alignment_id": {"type": "null"},
          "alignment_semantic_sha256": {"type": "null"},
          "alignment_status": {"const": "UNVERIFIED"}
        }
      },
      "else": {
        "properties": {
          "ready_manifest_id": {
            "$ref": "../v1/common.schema.json#/$defs/uuid"
          },
          "ready_manifest_semantic_sha256": {
            "$ref": "../v1/common.schema.json#/$defs/sha256"
          },
          "mapping_profile": {
            "properties": {"approved": {"const": true}},
            "required": ["approved"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"alignment_status": {"const": "VALID"}},
        "required": ["alignment_status"]
      },
      "then": {
        "properties": {
          "alignment_id": {
            "$ref": "../v1/common.schema.json#/$defs/uuid"
          },
          "alignment_semantic_sha256": {
            "$ref": "../v1/common.schema.json#/$defs/sha256"
          }
        }
      },
      "else": {
        "properties": {
          "alignment_id": {"type": "null"},
          "alignment_semantic_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "timestampSidecarArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "row_count"],
      "properties": {
        "artifact": {
          "allOf": [
            {"$ref": "artifact-registry-entry.schema.json"},
            {
              "properties": {
                "artifact_type": {"const": "CAMERA_VIDEO_TIMESTAMP_MAP"}
              }
            }
          ]
        },
        "row_count": {"type": "integer", "minimum": 1}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "source",
        "input_message_count",
        "source_first_observed_message_ns",
        "source_last_observed_message_ns",
        "export_first_observed_source_message_ns",
        "export_last_observed_source_message_ns",
        "leading_drops",
        "trailing_drops",
        "exported_packet_count",
        "exported_frame_count",
        "keyframe_count",
        "width",
        "height",
        "video_artifact",
        "timestamp_sidecar_artifact",
        "media_time_mapping"
      ],
      "properties": {
        "camera_id": {"$ref": "../v1/common.schema.json#/$defs/cameraId"},
        "source": {
          "$ref": "../v1/camera-video-export-manifest.schema.json#/$defs/source"
        },
        "input_message_count": {"type": "integer", "minimum": 1},
        "source_first_observed_message_ns": {
          "$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"
        },
        "source_last_observed_message_ns": {
          "$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"
        },
        "export_first_observed_source_message_ns": {
          "$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"
        },
        "export_last_observed_source_message_ns": {
          "$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"
        },
        "leading_drops": {
          "$ref": "../v1/camera-video-export-manifest.schema.json#/$defs/dropProvenance"
        },
        "trailing_drops": {
          "$ref": "../v1/camera-video-export-manifest.schema.json#/$defs/dropProvenance"
        },
        "exported_packet_count": {"type": "integer", "minimum": 1},
        "exported_frame_count": {"type": "integer", "minimum": 1},
        "keyframe_count": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "video_artifact": {
          "allOf": [
            {"$ref": "artifact-registry-entry.schema.json"},
            {
              "properties": {
                "artifact_type": {"const": "CAMERA_VIDEO_MP4"}
              }
            }
          ]
        },
        "timestamp_sidecar_artifact": {
          "$ref": "#/$defs/timestampSidecarArtifact"
        },
        "media_time_mapping": {
          "$ref": "../v1/camera-video-export-manifest.schema.json#/$defs/mediaTimeMapping"
        }
      }
    }
  }
}
