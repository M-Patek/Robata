# Copy to an untracked .env.production or inject equivalents through your
# deployment secret manager. Never commit live credential values.

ROBATA_TENANT_ID=<tenant-id>

# One immutable PostgreSQL/Supabase target. All runtime connections require TLS.
CANONICAL_POSTGRES_HOST=<postgres-host>
CANONICAL_POSTGRES_PORT=5432
CANONICAL_POSTGRES_DATABASE=postgres
CANONICAL_POSTGRES_SSLMODE=verify-full
CANONICAL_POSTGRES_SSLROOTCERT=/run/secrets/postgres-ca.pem
CANONICAL_POSTGRES_CA_FILE=./secrets/postgres-ca.pem
CANONICAL_POSTGRES_CONNECT_TIMEOUT_SECONDS=10
CANONICAL_POSTGRES_SCHEMA=robata_canonical
CANONICAL_POSTGRES_REQUIRE_RLS=true
CANONICAL_POSTGRES_TENANT_CONTEXT_SETTING=robata.tenant_id

# Migration DDL role. This role is used only by canonical-migrate.
CANONICAL_POSTGRES_MIGRATOR_USER=<canonical-migrator-role>
CANONICAL_POSTGRES_MIGRATOR_PASSWORD=<canonical-migrator-password>
CANONICAL_POSTGRES_MIGRATOR_APPLICATION_NAME=robata-canonical-migrator

# Runtime roles must be distinct and must not have BYPASSRLS.
CANONICAL_POSTGRES_APP_USER=<canonical-application-role>
CANONICAL_POSTGRES_APP_PASSWORD=<canonical-application-password>
CANONICAL_POSTGRES_APP_APPLICATION_NAME=robata-canonical-app
CANONICAL_POSTGRES_WORKER_USER=<canonical-worker-role>
CANONICAL_POSTGRES_WORKER_PASSWORD=<canonical-worker-password>
CANONICAL_POSTGRES_WORKER_APPLICATION_NAME=robata-canonical-worker

# Compose-only paths for the reviewed, non-secret bootstrap and its exact
# release artifacts. The paths on the right are host paths; the runtime JSON
# itself must refer to the mounted /run/secrets/* paths below.
ROBATA_PRODUCTION_RUNTIME_CONFIG=/run/secrets/production-runtime.json
ROBATA_PRODUCTION_RUNTIME_CONFIG_FILE=./secrets/production-runtime.json
ROBATA_PRIMARY_QUALIFICATION_REPORT_FILE=./secrets/primary-qualification-report.json
ROBATA_PRIMARY_RELEASE_DECISION_FILE=./secrets/primary-release-decision.json

# R2 exact-byte artifact storage.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>
R2_PREFIX=robata
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# pgvector remains a derived projection, separate from canonical authority.
PGVECTOR_HOST=<postgres-host>
PGVECTOR_DATABASE=postgres
PGVECTOR_USER=<vector-application-role>
PGVECTOR_PASSWORD=<vector-application-password>
PGVECTOR_SSLMODE=verify-full
PGVECTOR_SSLROOTCERT=/run/secrets/postgres-ca.pem
PGVECTOR_DIMENSION=<embedding-dimension>
PGVECTOR_BACKEND=POSTGRES
PGVECTOR_REQUIRE_RLS=true
PGVECTOR_WORKER_HOST=<postgres-host>
PGVECTOR_WORKER_DATABASE=postgres
PGVECTOR_WORKER_USER=<vector-worker-role>
PGVECTOR_WORKER_PASSWORD=<vector-worker-password>
PGVECTOR_WORKER_SSLMODE=verify-full
PGVECTOR_WORKER_SSLROOTCERT=/run/secrets/postgres-ca.pem
PGVECTOR_WORKER_ROLE=<vector-worker-role>

# The existing optional-adapter preflight validates these pinned RunPod facts
# without dispatching inference. Keep primary/candidate endpoint values distinct.
RUNPOD_API_KEY=<runpod-api-key>
RUNPOD_CONTROL_ENDPOINT_URL=https://api.runpod.ai/v2/<control-endpoint-id>/runsync
RUNPOD_CONTROL_MODEL_IDENTIFIER=<primary-model-id>
RUNPOD_CONTROL_MODEL_VERSION=<primary-model-version>
RUNPOD_CONTROL_HANDLER_IMAGE=<image-reference>
RUNPOD_CONTROL_HANDLER_IMAGE_SHA256=<64-lowercase-hex-digest>
RUNPOD_CONTROL_CAPABILITY_SNAPSHOT_SHA256=<64-lowercase-hex-digest>
RUNPOD_CONTROL_INFERENCE_ENGINE=<engine>
RUNPOD_CONTROL_PRECISION_OR_QUANTIZATION=<precision>
RUNPOD_CONTROL_TOPOLOGY=TWO_SINGLE_CARD_REPLICAS
RUNPOD_CONTROL_MAX_OUTPUT_TOKENS=1024
RUNPOD_CONTROL_ADAPTER_VERSION=runpod-adapter-v1
RUNPOD_CONTROL_NATIVE_BATCH_ENABLED=false
RUNPOD_CONTROL_NATIVE_BATCH_MAX_SIZE=1
RUNPOD_CONTROL_MAX_CONCURRENT_REQUESTS=1
RUNPOD_CONTROL_REQUEST_TIMEOUT_CAP_MS=120000
RUNPOD_CONTROL_MAX_RESPONSE_BYTES=4194304
RUNPOD_CANDIDATE_ENDPOINT_URL=https://api.runpod.ai/v2/<candidate-endpoint-id>/runsync
RUNPOD_CANDIDATE_MODEL_IDENTIFIER=<candidate-model-id>
RUNPOD_CANDIDATE_MODEL_VERSION=<candidate-model-version>
RUNPOD_CANDIDATE_HANDLER_IMAGE=<image-reference>
RUNPOD_CANDIDATE_HANDLER_IMAGE_SHA256=<64-lowercase-hex-digest>
RUNPOD_CANDIDATE_CAPABILITY_SNAPSHOT_SHA256=<64-lowercase-hex-digest>
RUNPOD_CANDIDATE_INFERENCE_ENGINE=<engine>
RUNPOD_CANDIDATE_PRECISION_OR_QUANTIZATION=<precision>
RUNPOD_CANDIDATE_TOPOLOGY=TWO_SINGLE_CARD_REPLICAS
RUNPOD_CANDIDATE_MAX_OUTPUT_TOKENS=1024
RUNPOD_CANDIDATE_ADAPTER_VERSION=runpod-adapter-v1
RUNPOD_CANDIDATE_NATIVE_BATCH_ENABLED=false
RUNPOD_CANDIDATE_NATIVE_BATCH_MAX_SIZE=1
RUNPOD_CANDIDATE_MAX_CONCURRENT_REQUESTS=1
RUNPOD_CANDIDATE_REQUEST_TIMEOUT_CAP_MS=120000
RUNPOD_CANDIDATE_MAX_RESPONSE_BYTES=4194304
