{
  "$defs": {
    "LocalStreamMergedHypothesis": {
      "additionalProperties": false,
      "description": "One label-preserving union of causal proposal fragments.\n\nThe source ordinals remain part of the local result: the union is a\nrecording-level convenience projection, not a replacement for the\ncontent-addressed window evidence that established it.",
      "properties": {
        "interval": {
          "$ref": "#/$defs/NanosecondInterval"
        },
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source_ordinals": {
          "items": {
            "type": "integer"
          },
          "title": "Source Ordinals",
          "type": "array"
        },
        "source_proposal_semantic_sha256_values": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Proposal Semantic Sha256 Values",
          "type": "array"
        }
      },
      "required": [
        "label",
        "interval",
        "source_ordinals",
        "source_proposal_semantic_sha256_values"
      ],
      "title": "LocalStreamMergedHypothesis",
      "type": "object"
    },
    "LocalStreamOutputDecision": {
      "enum": [
        "ADMITTED",
        "NO_EVENTS",
        "ABSTAINED"
      ],
      "type": "string"
    },
    "NanosecondInterval": {
      "additionalProperties": false,
      "description": "A nonempty half-open interval ``[start_ns, end_ns)``.",
      "properties": {
        "end_ns": {
          "title": "End Ns",
          "type": "string"
        },
        "start_ns": {
          "title": "Start Ns",
          "type": "string"
        }
      },
      "required": [
        "start_ns",
        "end_ns"
      ],
      "title": "NanosecondInterval",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "Exact immutable four-tuple required at durable consumer boundaries.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^https://schemas\\.robata\\.dev/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "version",
        "artifact_id",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    },
    "StreamArtifactRef": {
      "additionalProperties": false,
      "description": "Exact immutable evidence reference used by terminal closure.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "byte_count": {
          "minimum": 1,
          "title": "Byte Count",
          "type": "integer"
        },
        "exact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Exact Sha256",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
          "title": "Media Type",
          "type": "string"
        },
        "schema_ref": {
          "$ref": "#/$defs/SchemaRef"
        }
      },
      "required": [
        "artifact_id",
        "exact_sha256",
        "byte_count",
        "media_type",
        "schema_ref"
      ],
      "title": "StreamArtifactRef",
      "type": "object"
    },
    "TerminalOutcome": {
      "description": "Terminal outcomes retained by stream closure, including failures.",
      "enum": [
        "SUCCEEDED",
        "SKIPPED_POLICY",
        "SKIPPED_NOT_NEEDED",
        "FAILED",
        "CANCELLED",
        "EXPIRED",
        "QUARANTINED",
        "LATE_INPUT",
        "INCOMPLETE",
        "ABSTAINED",
        "NO_EVENTS",
        "INVALIDATED"
      ],
      "title": "TerminalOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.robata.dev/v3/local-stream-recording-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Ordinal-bound causal reduction over W1 results and S2 window evidence.",
  "properties": {
    "canonical_requested_interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/NanosecondInterval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "capture_scope_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capture Scope Digest",
      "type": "string"
    },
    "evidence_class": {
      "const": "LOCAL_CONFORMANCE",
      "default": "LOCAL_CONFORMANCE",
      "title": "Evidence Class",
      "type": "string"
    },
    "expected_plan_seal_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Plan Seal Semantic Sha256",
      "type": "string"
    },
    "final_recording_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Recording Identity",
      "type": "string"
    },
    "merged_hypotheses": {
      "items": {
        "$ref": "#/$defs/LocalStreamMergedHypothesis"
      },
      "title": "Merged Hypotheses",
      "type": "array"
    },
    "ordered_window_result_semantic_sha256_values": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Window Result Semantic Sha256 Values",
      "type": "array"
    },
    "ordered_window_semantic_evidence_refs": {
      "items": {
        "$ref": "#/$defs/StreamArtifactRef"
      },
      "title": "Ordered Window Semantic Evidence Refs",
      "type": "array"
    },
    "ordered_window_semantic_evidence_sha256_values": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ordered Window Semantic Evidence Sha256 Values",
      "type": "array"
    },
    "ordered_window_semantic_statuses": {
      "items": {
        "enum": [
          "PROPOSED",
          "NO_EVENTS",
          "ABSTAINED"
        ],
        "type": "string"
      },
      "title": "Ordered Window Semantic Statuses",
      "type": "array"
    },
    "ordered_window_terminal_outcomes": {
      "items": {
        "$ref": "#/$defs/TerminalOutcome"
      },
      "title": "Ordered Window Terminal Outcomes",
      "type": "array"
    },
    "output_decision": {
      "$ref": "#/$defs/LocalStreamOutputDecision"
    },
    "plan_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Plan Key",
      "type": "string"
    },
    "production_eligible": {
      "const": false,
      "default": false,
      "title": "Production Eligible",
      "type": "boolean"
    },
    "recording_finalization_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recording Finalization Semantic Sha256",
      "type": "string"
    },
    "recording_result_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Recording Result Key",
      "type": "string"
    },
    "recording_result_projection_version": {
      "const": "local-stream-recording-result-semantic-v3",
      "default": "local-stream-recording-result-semantic-v3",
      "title": "Recording Result Projection Version",
      "type": "string"
    },
    "recording_result_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recording Result Semantic Sha256",
      "type": "string"
    },
    "reduction_policy_version": {
      "const": "local-conformance-stream-recording-reduction-v3",
      "default": "local-conformance-stream-recording-reduction-v3",
      "title": "Reduction Policy Version",
      "type": "string"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "schema_version": {
      "const": "3.0",
      "default": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_timeline_origin_ns": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Timeline Origin Ns"
    },
    "window_terminal_closure_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Window Terminal Closure Semantic Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "schema_ref",
    "evidence_class",
    "production_eligible",
    "recording_result_projection_version",
    "reduction_policy_version",
    "capture_scope_digest",
    "plan_key",
    "expected_plan_seal_semantic_sha256",
    "window_terminal_closure_semantic_sha256",
    "recording_finalization_semantic_sha256",
    "final_recording_identity",
    "source_timeline_origin_ns",
    "canonical_requested_interval",
    "ordered_window_result_semantic_sha256_values",
    "ordered_window_terminal_outcomes",
    "ordered_window_semantic_evidence_refs",
    "ordered_window_semantic_evidence_sha256_values",
    "ordered_window_semantic_statuses",
    "merged_hypotheses",
    "output_decision",
    "recording_result_key",
    "recording_result_semantic_sha256"
  ],
  "title": "LocalStreamRecordingResultV3",
  "type": "object"
}
