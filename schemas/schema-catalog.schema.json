{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.robata.dev/catalog/schema-catalog.schema.json",
  "title": "Robata schema catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "schemas", "upcasters"],
  "properties": {
    "catalog_version": {"const": "1.0"},
    "schemas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schemaEntry"}},
    "upcasters": {"type": "array", "items": {"$ref": "#/$defs/upcasterEntry"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "schemaId": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://schemas\\.robata\\.dev/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "wireVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "artifactId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "version", "artifact_id", "sha256"],
      "properties": {
        "schema_id": {"$ref": "#/$defs/schemaId"},
        "version": {"$ref": "#/$defs/version"},
        "artifact_id": {"$ref": "#/$defs/artifactId"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "softwareRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_inclusive", "max_exclusive"],
      "properties": {
        "min_inclusive": {"$ref": "#/$defs/version"},
        "max_exclusive": {"$ref": "#/$defs/version"}
      }
    },
    "schemaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "wire_version",
        "document_id",
        "artifact_path",
        "owner",
        "canonicalization_version",
        "projection_version",
        "compatibility_mode",
        "lifecycle",
        "supported_software",
        "supported_predecessors"
      ],
      "properties": {
        "ref": {"$ref": "#/$defs/schemaRef"},
        "wire_version": {"$ref": "#/$defs/wireVersion"},
        "document_id": {"type": "string", "format": "uri", "minLength": 1},
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "owner": {"type": "string", "minLength": 1},
        "canonicalization_version": {"type": "string", "minLength": 1},
        "projection_version": {"type": "string", "minLength": 1},
        "compatibility_mode": {"enum": ["BACKWARD", "FORWARD", "FULL", "NONE"]},
        "lifecycle": {"enum": ["ACTIVE", "DEPRECATED", "RETIRED"]},
        "supported_software": {"$ref": "#/$defs/softwareRange"},
        "supported_predecessors": {
          "type": "array",
          "items": {"$ref": "#/$defs/schemaRef"}
        }
      }
    },
    "upcasterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upcaster_id",
        "source",
        "target",
        "code_artifact_id",
        "code_artifact_path",
        "code_sha256",
        "runtime_artifact_id",
        "runtime_artifact_path",
        "runtime_sha256",
        "golden_vectors"
      ],
      "properties": {
        "upcaster_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "source": {"$ref": "#/$defs/schemaRef"},
        "target": {"$ref": "#/$defs/schemaRef"},
        "code_artifact_id": {"$ref": "#/$defs/artifactId"},
        "code_artifact_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "code_sha256": {"$ref": "#/$defs/digest"},
        "runtime_artifact_id": {"$ref": "#/$defs/artifactId"},
        "runtime_artifact_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "runtime_sha256": {"$ref": "#/$defs/digest"},
        "golden_vectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/goldenVector"}
        }
      }
    },
    "goldenVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_artifact_path",
        "input_sha256",
        "output_artifact_path",
        "output_sha256"
      ],
      "properties": {
        "input_artifact_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "input_sha256": {"$ref": "#/$defs/digest"},
        "output_artifact_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "output_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
