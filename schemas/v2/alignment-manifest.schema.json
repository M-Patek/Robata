{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.robata.dev/v2/alignment-manifest.schema.json",
  "title": "Robata AlignmentManifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "alignment_id",
    "alignment_semantic_sha256",
    "mcap_id",
    "recording_identity",
    "source_content_sha256",
    "ready_manifest_id",
    "ready_manifest_semantic_sha256",
    "ready_manifest_schema_ref",
    "camera_mapping_run_id",
    "camera_mapping_semantic_sha256",
    "reference_timebase",
    "canonical_origin",
    "method",
    "algorithm",
    "status",
    "cameras",
    "policy",
    "validator",
    "checks",
    "diagnostics",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "schema_ref": {
      "allOf": [
        {"$ref": "artifact-registry-entry.schema.json#/$defs/schemaArtifactReference"},
        {
          "properties": {
            "schema_id": {"const": "https://schemas.robata.dev/alignment-manifest"},
            "version": {"const": "2.0.0"}
          }
        }
      ]
    },
    "alignment_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
    "alignment_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "mcap_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
    "recording_identity": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "source_content_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "ready_manifest_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
    "ready_manifest_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "ready_manifest_schema_ref": {
      "allOf": [
        {"$ref": "artifact-registry-entry.schema.json#/$defs/schemaArtifactReference"},
        {
          "properties": {
            "schema_id": {"const": "https://schemas.robata.dev/mcap-manifest"},
            "version": {"const": "2.0.0"}
          }
        }
      ]
    },
    "camera_mapping_run_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
    "camera_mapping_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "reference_timebase": {"type": "string", "minLength": 1},
    "canonical_origin": {"$ref": "#/$defs/canonicalOrigin"},
    "method": {"enum": ["hardware_sync", "sensor_clock", "mcap_log_time", "cross_correlation", "manual"]},
    "algorithm": {"$ref": "#/$defs/evidenceComponent"},
    "status": {"$ref": "#/$defs/alignmentStatus"},
    "cameras": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cam_01", "cam_02", "cam_03", "cam_04", "cam_05", "cam_06"],
      "properties": {
        "cam_01": {"$ref": "#/$defs/cameraAlignment"},
        "cam_02": {"$ref": "#/$defs/cameraAlignment"},
        "cam_03": {"$ref": "#/$defs/cameraAlignment"},
        "cam_04": {"$ref": "#/$defs/cameraAlignment"},
        "cam_05": {"$ref": "#/$defs/cameraAlignment"},
        "cam_06": {"$ref": "#/$defs/cameraAlignment"}
      }
    },
    "policy": {"$ref": "#/$defs/semanticPolicyReference"},
    "validator": {"$ref": "#/$defs/evidenceComponent"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/checkEvidence"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "created_at": {"$ref": "../v1/common.schema.json#/$defs/rfc3339"}
  },
  "$defs": {
    "alignmentStatus": {"enum": ["VALID", "DEGRADED", "INVALID", "UNVERIFIED"]},
    "evidenceComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "code_sha256", "configuration_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "code_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
        "configuration_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"}
      }
    },
    "semanticPolicyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "semantic_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"}
      }
    },
    "canonicalOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference_timestamp_ns", "utc"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "reference_timestamp_ns": {"$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"},
        "utc": {
          "oneOf": [
            {"$ref": "../v1/common.schema.json#/$defs/rfc3339"},
            {"type": "null"}
          ]
        }
      }
    },
    "checkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "check_version", "subject", "outcome", "diagnostic_ids"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "check_version": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE"]},
        "diagnostic_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id",
        "code",
        "message",
        "classification",
        "severity",
        "path",
        "camera_id",
        "stream_id"
      ],
      "properties": {
        "diagnostic_id": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "classification": {"enum": ["SOURCE", "POLICY", "INFRASTRUCTURE"]},
        "severity": {"enum": ["INFO", "WARNING", "ERROR"]},
        "path": {"type": ["string", "null"]},
        "camera_id": {
          "oneOf": [
            {"$ref": "../v1/common.schema.json#/$defs/cameraId"},
            {"type": "null"}
          ]
        },
        "stream_id": {
          "oneOf": [
            {"$ref": "../v1/common.schema.json#/$defs/uuid"},
            {"type": "null"}
          ]
        }
      }
    },
    "cameraAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_clock_id",
        "source_timestamp_unit",
        "derived_drift_ppm",
        "residual_p95_ns",
        "max_error_ns",
        "coverage",
        "segments",
        "status",
        "stream_id",
        "stream_semantic_sha256"
      ],
      "properties": {
        "source_clock_id": {"type": "string", "minLength": 1},
        "source_timestamp_unit": {"const": "ns"},
        "derived_drift_ppm": {"type": "number"},
        "residual_p95_ns": {"$ref": "../v1/common.schema.json#/$defs/nonnegativeInt64Nanoseconds"},
        "max_error_ns": {"$ref": "../v1/common.schema.json#/$defs/nonnegativeInt64Nanoseconds"},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/segment"}
        },
        "status": {"$ref": "#/$defs/alignmentStatus"},
        "stream_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
        "stream_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "source_epoch_id",
        "source_order_start",
        "source_order_end",
        "source_start_ns",
        "source_end_ns",
        "source_anchor_ns",
        "canonical_anchor_ns",
        "rate_numerator",
        "rate_denominator",
        "rounding"
      ],
      "properties": {
        "segment_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
        "source_epoch_id": {"type": "string", "minLength": 1},
        "source_order_start": {"type": "integer", "minimum": 0},
        "source_order_end": {"type": "integer", "minimum": 0},
        "source_start_ns": {"$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"},
        "source_end_ns": {"$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"},
        "source_anchor_ns": {"$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"},
        "canonical_anchor_ns": {"$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"},
        "rate_numerator": {"$ref": "../v1/common.schema.json#/$defs/positiveInt64String"},
        "rate_denominator": {"$ref": "../v1/common.schema.json#/$defs/positiveInt64String"},
        "rounding": {"const": "HALF_EVEN"}
      }
    }
  }
}
