{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.robata.dev/v2/mcap-validation-report.schema.json",
  "title": "Robata MCAPValidationReport V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "validation_report_id",
    "validation_report_semantic_sha256",
    "mcap_id",
    "recording_identity",
    "source_content_sha256",
    "source",
    "mapping_policy",
    "camera_mapping_semantic_sha256",
    "validator",
    "checks",
    "diagnostics",
    "schema_evidence",
    "probed_stream_facts",
    "camera_mappings",
    "discovered_video_stream_count",
    "mapped_camera_count",
    "verdict",
    "validated_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "schema_ref": {
      "allOf": [
        {"$ref": "artifact-registry-entry.schema.json#/$defs/schemaArtifactReference"},
        {
          "properties": {
            "schema_id": {"const": "https://schemas.robata.dev/mcap-validation-report"},
            "version": {"const": "2.0.0"}
          }
        }
      ]
    },
    "validation_report_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
    "validation_report_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "mcap_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
    "recording_identity": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "source_content_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "source": {"$ref": "#/$defs/source"},
    "mapping_policy": {"$ref": "#/$defs/semanticPolicyReference"},
    "camera_mapping_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
    "validator": {"$ref": "#/$defs/evidenceComponent"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/checkEvidence"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "schema_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/schemaEvidence"}
    },
    "probed_stream_facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/probedStreamFact"}
    },
    "camera_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/cameraMapping"}
    },
    "discovered_video_stream_count": {"type": "integer", "minimum": 0},
    "mapped_camera_count": {"type": "integer", "minimum": 0},
    "verdict": {"enum": ["VALID", "INVALID", "INCONCLUSIVE"]},
    "validated_at": {"$ref": "../v1/common.schema.json#/$defs/rfc3339"}
  },
  "$defs": {
    "evidenceComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "code_sha256", "configuration_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "code_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
        "configuration_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"}
      }
    },
    "semanticPolicyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "semantic_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id",
        "code",
        "message",
        "classification",
        "severity",
        "path",
        "camera_id",
        "stream_id"
      ],
      "properties": {
        "diagnostic_id": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "classification": {"enum": ["SOURCE", "POLICY", "INFRASTRUCTURE"]},
        "severity": {"enum": ["INFO", "WARNING", "ERROR"]},
        "path": {"type": ["string", "null"]},
        "camera_id": {
          "oneOf": [
            {"$ref": "../v1/common.schema.json#/$defs/cameraId"},
            {"type": "null"}
          ]
        },
        "stream_id": {
          "oneOf": [
            {"$ref": "../v1/common.schema.json#/$defs/uuid"},
            {"type": "null"}
          ]
        }
      }
    },
    "checkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "check_version", "subject", "outcome", "diagnostic_ids"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "check_version": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE"]},
        "diagnostic_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "schemaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "stream_semantic_sha256",
        "schema_name",
        "schema_encoding",
        "schema_content_sha256",
        "support_status",
        "support_policy",
        "diagnostic_ids"
      ],
      "properties": {
        "stream_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
        "stream_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
        "schema_name": {"type": "string", "minLength": 1},
        "schema_encoding": {"type": "string", "minLength": 1},
        "schema_content_sha256": {
          "oneOf": [
            {"$ref": "../v1/common.schema.json#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "support_status": {"enum": ["SUPPORTED", "UNSUPPORTED", "INCONCLUSIVE"]},
        "support_policy": {"$ref": "#/$defs/semanticPolicyReference"},
        "diagnostic_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "decoderProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe",
        "outcome",
        "decoded_frame_count",
        "decoded_width",
        "decoded_height",
        "diagnostic_ids"
      ],
      "properties": {
        "probe": {"$ref": "#/$defs/evidenceComponent"},
        "outcome": {"enum": ["PASSED", "FAILED", "INCONCLUSIVE", "NOT_RUN"]},
        "decoded_frame_count": {"type": "integer", "minimum": 0},
        "decoded_width": {"type": ["integer", "null"], "minimum": 1},
        "decoded_height": {"type": ["integer", "null"], "minimum": 1},
        "diagnostic_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "probedStreamFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "stream_semantic_sha256",
        "topic",
        "channel_id",
        "message_encoding",
        "codec",
        "message_count",
        "first_timestamp_ns",
        "last_timestamp_ns",
        "decoder_probe"
      ],
      "properties": {
        "stream_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
        "stream_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
        "topic": {"type": "string", "minLength": 1},
        "channel_id": {"type": "integer", "minimum": 0},
        "message_encoding": {"type": "string", "minLength": 1},
        "codec": {"type": "string", "minLength": 1},
        "message_count": {"type": "integer", "minimum": 0},
        "first_timestamp_ns": {
          "oneOf": [
            {"$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"},
            {"type": "null"}
          ]
        },
        "last_timestamp_ns": {
          "oneOf": [
            {"$ref": "../v1/common.schema.json#/$defs/int64Nanoseconds"},
            {"type": "null"}
          ]
        },
        "decoder_probe": {"$ref": "#/$defs/decoderProbe"}
      }
    },
    "cameraMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_id", "role", "stream_id", "stream_semantic_sha256"],
      "properties": {
        "camera_id": {"$ref": "../v1/common.schema.json#/$defs/cameraId"},
        "role": {"type": "string", "minLength": 1},
        "stream_id": {"$ref": "../v1/common.schema.json#/$defs/uuid"},
        "stream_semantic_sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "object_version", "sha256", "bytes"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "object_version": {"type": ["string", "null"]},
        "sha256": {"$ref": "../v1/common.schema.json#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
