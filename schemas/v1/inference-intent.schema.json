          "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/sha256"
        },
        "input_plan_id": {
          "anyOf": [
            {
              "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_plan_semantic_sha256": {
          "anyOf": [
            {
              "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_plan_part_ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_plan_part_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_plan_part_semantic_sha256": {
          "anyOf": [
            {
              "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceInputPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_schema": {
          "$ref": "#/$defs/JsonSchemaRef"
        },
        "capability_snapshot_id": {
          "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/uuid"
        },
        "capability_snapshot_digest": {
          "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/sha256"
        },
        "model_policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
          "type": "string"
        },
        "generation_config": {
          "additionalProperties": true,
          "type": "object"
        },
        "provider_idempotency_key": {
          "minLength": 1,
          "type": "string"
        },
        "timeout_ms": {
          "minimum": 1,
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "logical_invocation_id",
        "request_id",
        "idempotency_key",
        "provider",
        "model_name",
        "model_version",
        "package_set_id",
        "package_inputs",
        "package_input_set_sha256",
        "task",
        "prompt_version",
        "prompt_artifact_id",
        "prompt_sha256",
        "rendered_input_digest",
        "input_plan_id",
        "input_plan_semantic_sha256",
        "input_plan_part_ordinal",
        "input_plan_part_count",
        "input_plan_part_semantic_sha256",
        "input_plan",
        "output_schema",
        "capability_snapshot_id",
        "capability_snapshot_digest",
        "model_policy_version",
        "generation_config",
        "provider_idempotency_key",
        "timeout_ms",
        "metadata"
      ],
      "type": "object"
    },
    "VisionTask": {
      "enum": [
        "QA_COARSE",
        "QA_DENSE",
        "EVENT_PROPOSAL",
        "ACTION_EVIDENCE",
        "BOUNDARY_REFINEMENT",
        "FUSION_ADJUDICATION"
      ],
      "type": "string"
    }
  }
