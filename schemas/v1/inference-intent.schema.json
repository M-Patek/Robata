        "RESIZE",
        "RESIZE_TRANSCODE",
        "TRANSCODE"
      ],
      "type": "string"
    },
    "TransformParameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
