        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "VisionInferenceRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "logical_invocation_id": {
          "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/uuid"
        },
        "request_id": {
          "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/uuid"
        },
        "idempotency_key": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "type": "string"
        },
        "model_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
          "type": "string"
        },
        "package_set_id": {
          "anyOf": [
            {
              "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "package_inputs": {
          "items": {
            "$ref": "#/$defs/PackageInput"
          },
          "type": "array"
        },
        "package_input_set_sha256": {
          "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/sha256"
        },
        "task": {
          "$ref": "#/$defs/VisionTask"
        },
        "prompt_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
          "type": "string"
        },
        "prompt_artifact_id": {
          "minLength": 1,
          "type": "string"
        },
        "prompt_sha256": {
          "$ref": "https://schemas.robata.dev/v1/common.schema.json#/$defs/sha256"
        },
