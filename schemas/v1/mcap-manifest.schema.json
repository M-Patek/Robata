{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.robata.dev/v1/mcap-manifest.schema.json",
  "title": "Robata V1 MCAPReadyManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mcap_id",
    "validation_report_id",
    "source",
    "recording",
    "camera_count",
    "camera_mapping_run_id",
    "camera_mapping_version",
    "cameras",
    "ingested_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "mcap_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "validation_report_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "recording": {
      "$ref": "#/$defs/recording"
    },
    "camera_count": {
      "const": 6
    },
    "camera_mapping_run_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "camera_mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "cameras": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_01"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_02"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_03"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_04"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_05"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/camera"},
            {"properties": {"camera_id": {"const": "cam_06"}}}
          ]
        }
      ],
      "items": false
    },
    "ingested_at": {
      "$ref": "common.schema.json#/$defs/rfc3339"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "version", "sha256", "bytes"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_utc", "end_utc", "duration_ns", "timebase"],
      "properties": {
        "start_utc": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/rfc3339"},
            {"type": "null"}
          ]
        },
        "end_utc": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/rfc3339"},
            {"type": "null"}
          ]
        },
        "duration_ns": {
          "$ref": "common.schema.json#/$defs/positiveInt64String"
        },
        "timebase": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "role",
        "stream_id",
        "topic",
        "channel_id",
        "codec",
        "width",
        "height",
        "nominal_fps",
        "source_start_ns",
        "source_end_ns",
        "frame_count"
      ],
      "properties": {
        "camera_id": {
          "$ref": "common.schema.json#/$defs/cameraId"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "channel_id": {
          "type": "integer",
          "minimum": 0
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "nominal_fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_start_ns": {
          "$ref": "common.schema.json#/$defs/int64Nanoseconds"
        },
        "source_end_ns": {
          "$ref": "common.schema.json#/$defs/int64Nanoseconds"
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
