{
  "$defs": {
    "SchemaRef": {
      "additionalProperties": false,
      "description": "Exact immutable four-tuple required at durable consumer boundaries.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^https://schemas\\.robata\\.dev/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "version",
        "artifact_id",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.robata.dev/v1/event-identity-outbox-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Transactional successor publication for one committed assignment.",
  "properties": {
    "assignment_logical_key": {
      "maxLength": 193,
      "minLength": 66,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z0-9][a-z0-9-]*)*:[0-9a-f]{64}$",
      "title": "Assignment Logical Key",
      "type": "string"
    },
    "key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Key",
      "type": "string"
    },
    "outbox_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Outbox Id",
      "type": "string"
    },
    "payload_reference": {
      "maxLength": 193,
      "minLength": 66,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z0-9][a-z0-9-]*)*:[0-9a-f]{64}$",
      "title": "Payload Reference",
      "type": "string"
    },
    "recording_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recording Identity",
      "type": "string"
    },
    "registry_generation": {
      "minimum": 1,
      "title": "Registry Generation",
      "type": "integer"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "topic": {
      "const": "event.identity.assignment",
      "title": "Topic",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "schema_ref",
    "outbox_id",
    "topic",
    "recording_identity",
    "key",
    "assignment_logical_key",
    "payload_reference",
    "registry_generation"
  ],
  "title": "EventIdentityOutboxRecord",
  "type": "object"
}
