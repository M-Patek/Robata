{
  "$defs": {
    "ReviewSubject": {
      "additionalProperties": false,
      "description": "Immutable logical subject and optional selected revision under review.",
      "properties": {
        "recording_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Recording Identity",
          "type": "string"
        },
        "selected_revision_logical_key": {
          "anyOf": [
            {
              "maxLength": 193,
              "minLength": 66,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z0-9][a-z0-9-]*)*:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Revision Logical Key"
        },
        "subject_id": {
          "maxLength": 193,
          "minLength": 66,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z0-9][a-z0-9-]*)*:[0-9a-f]{64}$",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$",
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "subject_type",
        "subject_id",
        "recording_identity",
        "selected_revision_logical_key"
      ],
      "title": "ReviewSubject",
      "type": "object"
    },
    "ReviewTrigger": {
      "description": "The review triggers explicitly named by Architecture V1 section 25.8.",
      "enum": [
        "LOW_CONFIDENCE",
        "DISAGREEMENT",
        "IDENTITY_AMBIGUITY",
        "QA_DEGRADATION",
        "REVIEW_SAMPLING"
      ],
      "title": "ReviewTrigger",
      "type": "string"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "Exact immutable four-tuple required at durable consumer boundaries.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^https://schemas\\.robata\\.dev/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "version",
        "artifact_id",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.robata.dev/v1/review-task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable nonblocking work definition persisted by the local review queue.",
  "properties": {
    "blocking": {
      "const": false,
      "title": "Blocking",
      "type": "boolean"
    },
    "due_at_ns": {
      "title": "Due At Ns",
      "type": "string"
    },
    "model_version": {
      "const": "review-task-internal-v1",
      "title": "Model Version",
      "type": "string"
    },
    "priority": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "reason_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at_ns": {
      "title": "Requested At Ns",
      "type": "string"
    },
    "review_task_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Review Task Id",
      "type": "string"
    },
    "routing_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Routing Policy Sha256",
      "type": "string"
    },
    "routing_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Routing Policy Version",
      "type": "string"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Semantic Sha256",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/ReviewSubject"
    },
    "trigger": {
      "$ref": "#/$defs/ReviewTrigger"
    }
  },
  "required": [
    "schema_version",
    "schema_ref",
    "model_version",
    "review_task_id",
    "semantic_sha256",
    "request_id",
    "subject",
    "trigger",
    "reason_codes",
    "priority",
    "requested_at_ns",
    "due_at_ns",
    "routing_policy_version",
    "routing_policy_sha256",
    "blocking"
  ],
  "title": "ReviewTask",
  "type": "object"
}
