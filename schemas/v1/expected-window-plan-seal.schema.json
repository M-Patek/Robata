{
  "$defs": {
    "SchemaRef": {
      "additionalProperties": false,
      "description": "Exact immutable four-tuple required at durable consumer boundaries.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^https://schemas\\.robata\\.dev/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "version",
        "artifact_id",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.robata.dev/v1/expected-window-plan-seal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One-way EOS seal derived only from source/policy facts.",
  "properties": {
    "capture_scope_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capture Scope Digest",
      "type": "string"
    },
    "clock_or_alignment_closure_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Clock Or Alignment Closure Semantic Sha256",
      "type": "string"
    },
    "eos_source_receipt_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Eos Source Receipt Semantic Sha256",
      "type": "string"
    },
    "expected_member_count": {
      "minimum": 0,
      "title": "Expected Member Count",
      "type": "integer"
    },
    "final_append_chain_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Append Chain Sha256"
    },
    "final_duration_ns": {
      "title": "Final Duration Ns",
      "type": "integer"
    },
    "final_source_timeline_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Source Timeline Semantic Sha256",
      "type": "string"
    },
    "first_ordinal": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Ordinal"
    },
    "idle_source_policy_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idle Source Policy Semantic Sha256",
      "type": "string"
    },
    "idle_source_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Idle Source Policy Version",
      "type": "string"
    },
    "last_ordinal_or_none": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Ordinal Or None"
    },
    "lateness_policy_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Lateness Policy Semantic Sha256",
      "type": "string"
    },
    "lateness_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Lateness Policy Version",
      "type": "string"
    },
    "mapping_closure_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Mapping Closure Semantic Sha256",
      "type": "string"
    },
    "ordered_expected_member_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ordered Expected Member Root Sha256",
      "type": "string"
    },
    "ordered_six_channel_health_closure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ordered Six Channel Health Closure Sha256",
      "type": "string"
    },
    "plan_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Plan Key",
      "type": "string"
    },
    "planner_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Planner Version",
      "type": "string"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seal_projection_version": {
      "default": "expected-window-plan-seal-semantic-v1",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Seal Projection Version",
      "type": "string"
    },
    "seal_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seal Semantic Sha256",
      "type": "string"
    },
    "segmentation_policy_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Segmentation Policy Semantic Sha256",
      "type": "string"
    },
    "segmentation_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Segmentation Policy Version",
      "type": "string"
    },
    "watermark_policy_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Watermark Policy Semantic Sha256",
      "type": "string"
    },
    "watermark_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Watermark Policy Version",
      "type": "string"
    },
    "window_policy_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Window Policy Semantic Sha256",
      "type": "string"
    },
    "window_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Window Policy Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "schema_ref",
    "plan_key",
    "capture_scope_digest",
    "eos_source_receipt_semantic_sha256",
    "final_source_timeline_semantic_sha256",
    "final_duration_ns",
    "ordered_six_channel_health_closure_sha256",
    "mapping_closure_semantic_sha256",
    "clock_or_alignment_closure_semantic_sha256",
    "segmentation_policy_version",
    "segmentation_policy_semantic_sha256",
    "window_policy_version",
    "window_policy_semantic_sha256",
    "watermark_policy_version",
    "watermark_policy_semantic_sha256",
    "lateness_policy_version",
    "lateness_policy_semantic_sha256",
    "idle_source_policy_version",
    "idle_source_policy_semantic_sha256",
    "planner_version",
    "expected_member_count",
    "first_ordinal",
    "last_ordinal_or_none",
    "final_append_chain_sha256",
    "ordered_expected_member_root_sha256",
    "seal_projection_version",
    "seal_semantic_sha256"
  ],
  "title": "ExpectedWindowPlanSeal",
  "type": "object"
}
