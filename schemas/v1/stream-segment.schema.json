{
  "$defs": {
    "CameraId": {
      "enum": [
        "cam_01",
        "cam_02",
        "cam_03",
        "cam_04",
        "cam_05",
        "cam_06"
      ],
      "title": "CameraId",
      "type": "string"
    },
    "NanosecondInterval": {
      "additionalProperties": false,
      "description": "A nonempty half-open interval ``[start_ns, end_ns)``.",
      "properties": {
        "end_ns": {
          "title": "End Ns",
          "type": "string"
        },
        "start_ns": {
          "title": "Start Ns",
          "type": "string"
        }
      },
      "required": [
        "start_ns",
        "end_ns"
      ],
      "title": "NanosecondInterval",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "Exact immutable four-tuple required at durable consumer boundaries.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^https://schemas\\.robata\\.dev/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "version",
        "artifact_id",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.robata.dev/v1/stream-segment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable non-final segment subject derived from one camera stream.",
  "properties": {
    "camera_id": {
      "$ref": "#/$defs/CameraId"
    },
    "capture_scope_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Capture Scope Digest",
      "type": "string"
    },
    "clock_or_alignment_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Clock Or Alignment Semantic Sha256",
      "type": "string"
    },
    "effective_interval": {
      "$ref": "#/$defs/NanosecondInterval"
    },
    "exact_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Exact Content Sha256",
      "type": "string"
    },
    "identity_policy_version": {
      "default": "stream-segment-identity-v1",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Identity Policy Version",
      "type": "string"
    },
    "mapping_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Mapping Semantic Sha256",
      "type": "string"
    },
    "ordered_packet_or_sequence_closure": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "title": "Ordered Packet Or Sequence Closure",
      "type": "array"
    },
    "requested_interval": {
      "$ref": "#/$defs/NanosecondInterval"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Segment Id",
      "type": "string"
    },
    "segment_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Segment Key",
      "type": "string"
    },
    "segment_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Segment Semantic Sha256",
      "type": "string"
    },
    "segmentation_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Segmentation Policy Version",
      "type": "string"
    },
    "semantic_projection_version": {
      "default": "stream-segment-semantic-v1",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Semantic Projection Version",
      "type": "string"
    },
    "subject_type": {
      "const": "STREAM_SEGMENT",
      "default": "STREAM_SEGMENT",
      "title": "Subject Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "schema_ref",
    "subject_type",
    "segment_id",
    "segment_key",
    "segment_semantic_sha256",
    "capture_scope_digest",
    "camera_id",
    "requested_interval",
    "effective_interval",
    "ordered_packet_or_sequence_closure",
    "exact_content_sha256",
    "mapping_semantic_sha256",
    "clock_or_alignment_semantic_sha256",
    "segmentation_policy_version",
    "semantic_projection_version",
    "identity_policy_version"
  ],
  "title": "StreamSegmentManifest",
  "type": "object"
}
