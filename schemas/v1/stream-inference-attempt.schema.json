{
  "$defs": {
    "SchemaRef": {
      "additionalProperties": false,
      "description": "Exact immutable four-tuple required at durable consumer boundaries.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^https://schemas\\.robata\\.dev/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "version",
        "artifact_id",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.robata.dev/v1/stream-inference-attempt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One dispatch attempt, separate from the stable logical invocation.",
  "properties": {
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "attempt_projection_version": {
      "default": "stream-inference-attempt-semantic-v1",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$",
      "title": "Attempt Projection Version",
      "type": "string"
    },
    "inference_attempt_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Inference Attempt Id",
      "type": "string"
    },
    "inference_attempt_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Inference Attempt Key",
      "type": "string"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stream_inference_logical_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Stream Inference Logical Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "schema_ref",
    "inference_attempt_id",
    "inference_attempt_key",
    "stream_inference_logical_id",
    "attempt_number",
    "attempt_projection_version"
  ],
  "title": "StreamInferenceAttemptIdentity",
  "type": "object"
}
