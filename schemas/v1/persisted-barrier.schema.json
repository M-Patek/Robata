{
  "$defs": {
    "DependencyCriticality": {
      "description": "How strongly a downstream work item depends on an upstream one.",
      "enum": [
        "REQUIRED",
        "DEGRADABLE",
        "OPTIONAL"
      ],
      "title": "DependencyCriticality",
      "type": "string"
    },
    "PersistedBarrierMember": {
      "additionalProperties": false,
      "description": "Terminal member fact included in a barrier snapshot.",
      "properties": {
        "criticality": {
          "$ref": "#/$defs/DependencyCriticality"
        },
        "outcome": {
          "enum": [
            "SUCCEEDED",
            "SKIPPED_POLICY",
            "SKIPPED_NOT_NEEDED",
            "FAILED",
            "CANCELLED",
            "EXPIRED",
            "QUARANTINED",
            "INCOMPLETE"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "work_item_id": {
          "minLength": 1,
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "work_item_id",
        "criticality",
        "outcome"
      ],
      "title": "PersistedBarrierMember",
      "type": "object"
    },
    "PersistedBarrierStatus": {
      "description": "Durable generic-barrier status, separate from member outcomes.",
      "enum": [
        "OPEN",
        "CLOSED",
        "FAILED"
      ],
      "title": "PersistedBarrierStatus",
      "type": "string"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "Exact immutable four-tuple required at durable consumer boundaries.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_id": {
          "pattern": "^https://schemas\\.robata\\.dev/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "title": "Schema Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_id",
        "version",
        "artifact_id",
        "sha256"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.robata.dev/v1/persisted-barrier.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Atomic snapshot of a generic SQLite barrier and its terminal members.",
  "properties": {
    "barrier_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Barrier Id",
      "type": "string"
    },
    "completed_members": {
      "minimum": 0,
      "title": "Completed Members",
      "type": "integer"
    },
    "empty_semantics": {
      "enum": [
        "SUCCEEDED",
        "SKIPPED_POLICY",
        "SKIPPED_NOT_NEEDED",
        "FAILED",
        "CANCELLED",
        "EXPIRED",
        "QUARANTINED",
        "INCOMPLETE"
      ],
      "title": "Empty Semantics",
      "type": "string"
    },
    "expected_member_count": {
      "minimum": 0,
      "title": "Expected Member Count",
      "type": "integer"
    },
    "failed_members": {
      "minimum": 0,
      "title": "Failed Members",
      "type": "integer"
    },
    "logical_key": {
      "minLength": 1,
      "title": "Logical Key",
      "type": "string"
    },
    "max_degraded_failures": {
      "minimum": 0,
      "title": "Max Degraded Failures",
      "type": "integer"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/PersistedBarrierMember"
      },
      "title": "Members",
      "type": "array"
    },
    "pending_members": {
      "minimum": 0,
      "title": "Pending Members",
      "type": "integer"
    },
    "reduction_policy": {
      "minLength": 1,
      "title": "Reduction Policy",
      "type": "string"
    },
    "required_success_count": {
      "minimum": 0,
      "title": "Required Success Count",
      "type": "integer"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_version": {
      "minimum": 0,
      "title": "State Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/PersistedBarrierStatus"
    }
  },
  "required": [
    "schema_version",
    "schema_ref",
    "barrier_id",
    "logical_key",
    "expected_member_count",
    "empty_semantics",
    "reduction_policy",
    "required_success_count",
    "max_degraded_failures",
    "state_version",
    "completed_members",
    "pending_members",
    "failed_members",
    "status",
    "members"
  ],
  "title": "PersistedBarrier",
  "type": "object"
}
